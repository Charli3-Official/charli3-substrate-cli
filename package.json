{
  "name": "charli3-substrate-cli",
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "devDependencies": {
    "@dedot/chaintypes": "^0.98.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.15.18",
    "@types/ws": "^8",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.1.3"
  },
  "scripts": {
    "build": "tsc",
    "charli3": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "eslint ./src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "ttd": "vitest",
    "repl": "tsx"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@polkadot/keyring": "^13.5.6",
    "@polkadot/util": "^13.5.6",
    "@polkadot/util-crypto": "^13.5.6",
    "commander": "^14.0.0",
    "dedot": "^0.10.0",
    "dotenv": "^16.5.0",
    "pino": "^9.7.0",
    "ws": "^8.18.3",
    "zod": "^3.25.28"
  }
}
