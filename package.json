{
  "name": "charli3-substrate-cli",
  "type": "module",
  "packageManager": "yarn@4.9.4",
  "devDependencies": {
    "@dedot/chaintypes": "^0.203.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@types/ws": "^8.18.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.0.16"
  },
  "scripts": {
    "build": "tsc",
    "charli3": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "lint": "eslint ./src --ext .ts,.tsx",
    "lint:fix": "eslint ./src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "ttd": "vitest",
    "repl": "tsx"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@polkadot/keyring": "^14.0.1",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "commander": "^14.0.2",
    "dedot": "^1.0.2",
    "dotenv": "^17.2.3",
    "js-yaml": "^4.1.1",
    "pino": "^10.1.0",
    "ws": "^8.18.3",
    "zod": "^4.2.1"
  }
}
